    "ac4cfc74-adf6-48df-a4ca-5afaa6451563": [
      {
        "block_id": "a6b04e2a-178d-4a10-9c6b-aee4bc9b8bba",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "heading_1",
        "text": "FAQ",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "01090a55-f006-4667-9af5-a41ea000c934",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "paragraph",
        "text": "Do I need experience to volunteer?",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "1a0745dd-057d-46e9-816c-0d7208075d00",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "paragraph",
        "text": "No prior experience is required for most roles.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "d4dd0c40-e3d4-4c95-85bf-ee718a5e6aab",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "paragraph",
        "text": "Are programs free for families?",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "7d9d3ae5-b940-4588-bd65-6f9ddf315661",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "paragraph",
        "text": "Yes, all programs are free thanks to donor support.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "e7b1b76c-bf41-439c-a7ea-8acf69e9f651",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "paragraph",
        "text": "How old do kids need to be to join?",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "6d17b0e7-0a15-4328-9dce-234c4c725914",
        "page_id": "ac4cfc74-adf6-48df-a4ca-5afaa6451563",
        "type": "paragraph",
        "text": "Most programs start at age 10, with a few open to younger siblings.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      }
    ],
    "7e7bb0bf-09ae-4ced-9b40-f024c8858147": [
      {
        "block_id": "2f3bf24b-78cc-4f3d-8050-14eb74fef38d",
        "page_id": "7e7bb0bf-09ae-4ced-9b40-f024c8858147",
        "type": "heading_1",
        "text": "About Us",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "ed0dae91-d484-4128-be81-61d50c3c435f",
        "page_id": "7e7bb0bf-09ae-4ced-9b40-f024c8858147",
        "type": "paragraph",
        "text": "Riverbend Youth Makerspace is a nonprofit workshop space where neighborhood kids learn to build, tinker and create.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "7af2f0e7-3dee-4d9d-9033-0ed91964dade",
        "page_id": "7e7bb0bf-09ae-4ced-9b40-f024c8858147",
        "type": "image",
        "text": "",
        "image_url": "https://tomiwaaluko.github.io/riverbend-assets/images/jordan-mentor.jpg",
        "caption": "Jordan, a longtime program mentor",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "f0cd7290-60a2-4a87-81c6-c9ae197c7a05",
        "page_id": "7e7bb0bf-09ae-4ced-9b40-f024c8858147",
        "type": "paragraph",
        "text": "We've been open since 2019 and run programs year-round.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      }
    ],
    "a983a11c-ad44-4525-9a12-7ffb313f580e": [
      {
        "block_id": "c2142f55-dbf5-42d3-bd48-bb5712f57699",
        "page_id": "a983a11c-ad44-4525-9a12-7ffb313f580e",
        "type": "heading_1",
        "text": "Annual Impact Report 2024",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "9b7cbc41-7913-4b59-bd08-3f7ac8a116ad",
        "page_id": "a983a11c-ad44-4525-9a12-7ffb313f580e",
        "type": "paragraph",
        "text": "Your gifts funded 38 workshops this year, reaching hundreds of neighborhood kids across Riverbend's after-school and weekend programs.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "f4884441-b313-4084-9e2f-aa3acbb3d8de",
        "page_id": "a983a11c-ad44-4525-9a12-7ffb313f580e",
        "type": "image",
        "text": "",
        "image_url": "https://tomiwaaluko.github.io/riverbend-assets/images/amara-okafor-portrait.jpg",
        "caption": "Volunteers like Amara gave 2,100 hours",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "da482214-8dd3-4ba8-a56b-7623d93a473e",
        "page_id": "a983a11c-ad44-4525-9a12-7ffb313f580e",
        "type": "paragraph",
        "text": "None of this happens without the generosity of our donors and the volunteers who show up week after week. Thank you for making 2024 possible.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      }
    ],
    "1e920a50-8af9-4712-b072-39265437da13": [
      {
        "block_id": "0f3174e9-c53d-4d96-b0ff-f301b0ebc2c5",
        "page_id": "1e920a50-8af9-4712-b072-39265437da13",
        "type": "heading_1",
        "text": "2024 Spring Workshop Recap",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "1330dc9b-6c04-43c0-9923-84ccd2e0bc08",
        "page_id": "1e920a50-8af9-4712-b072-39265437da13",
        "type": "paragraph",
        "text": "Two days, one maze-navigation challenge, and a room full of neighborhood teens building homemade robots from scratch. This year's spring robotics workshop paired first-time builders with returning mentors, rotating through tables to help debug wiring and motor control.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "fa07d443-94fb-4c46-afd2-2ee388f28f5c",
        "page_id": "1e920a50-8af9-4712-b072-39265437da13",
        "type": "image",
        "text": "",
        "image_url": "https://tomiwaaluko.github.io/riverbend-assets/images/amara-okafor-portrait.jpg",
        "caption": "Amara leading the robotics table on day two",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "9e3996cb-6aaf-44cb-b1bc-3ec2453f179c",
        "page_id": "1e920a50-8af9-4712-b072-39265437da13",
        "type": "paragraph",
        "text": "By the second day, teams were running their robots through a full obstacle course, cheered on by parents and staff.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "1070ab0a-abe5-41cd-94c4-095c34da0f13",
        "page_id": "1e920a50-8af9-4712-b072-39265437da13",
        "type": "image",
        "text": "",
        "image_url": "https://tomiwaaluko.github.io/riverbend-assets/images/workshop-participant.jpg",
        "caption": "A participant testing their robot's arm on day one",
        "archived": false,
        "link_urls": []
      },
      {
        "block_id": "b1e62413-1027-421a-a7ba-8c83e0c4e0a4",
        "page_id": "1e920a50-8af9-4712-b072-39265437da13",
        "type": "paragraph",
        "text": "Thanks to everyone who volunteered their weekend to make this workshop happen.",
        "image_url": null,
        "caption": "",
        "archived": false,
        "link_urls": []
      }
    ]
  },
